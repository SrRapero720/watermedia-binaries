From 1c3aa43f8a3558a6eb3bad526812f53692f6725d Mon Sep 17 00:00:00 2001
From: J-RAP <srrapero720@hotmail.com>
Date: Fri, 27 Nov 2026 13:35:25 -0600
Subject: [PATCH 5/5] avformat/http: keep the connection that answered with a
 redirect

The connection is closed whenever its reply is a redirect, although the
next request often goes to the same host: the redirect may stay on that
host, and requests that are redirected to another host come back to the
first one with their next request.

Skip the body of a redirect when it arrived completely with the header,
which is the common case for such short replies, and keep the
connection. Waiting for more data could stall on a broken server, so a
body that is not buffered completely, a reply without a known length or
with data after its end, a reply that announces the end of the
connection and the reply to an upload whose data was not sent yet still
close it.

With the previous commit, the segments of a HLS playlist that are all
redirected from one host to another no longer need new connections.

(cherry picked from commit e62f886ce28a6922d01f5154a5d928c3a7edd512)
Signed-off-by: J-RAP <srrapero720@hotmail.com>
---
 libavformat/http.c | 74 +++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 73 insertions(+), 1 deletion(-)

diff --git a/libavformat/http.c b/libavformat/http.c
index d9c2490c4c..b61ecdd41a 100644
--- a/libavformat/http.c
+++ b/libavformat/http.c
@@ -439,6 +439,77 @@ static int redirect_cache_set(HTTPContext *s, const char *source, const char *de
     return 0;
 }
 
+/**
+ * Skip the body of a reply that is answered with another request, so that
+ * its connection can carry that request. This only uses the data that
+ * arrived with the header, as waiting for more could stall on a broken
+ * server.
+ *
+ * @return non zero if the body was skipped, 0 if the connection has to be
+ *         closed instead
+ */
+static int http_skip_body(URLContext *h)
+{
+    HTTPContext *s = h->priv_data;
+    const uint8_t *p = s->buf_ptr, *end = s->buf_end;
+
+    /* The body of an upload may not have been sent yet, and the length of
+     * a partial reply is that of its range. */
+    if (s->willclose || ((h->flags & AVIO_FLAG_WRITE) && !s->post_data) ||
+        s->filesize_from_content_range != UINT64_MAX)
+        return 0;
+
+    if (s->chunksize == UINT64_MAX) {
+        /* a HEAD reply states the length of a body it does not carry */
+        uint64_t size = s->method && !av_strcasecmp(s->method, "HEAD") ?
+                        0 : s->filesize;
+
+        if (size > (uint64_t)(end - p))
+            return 0;
+        p += size;
+    } else {
+        for (;;) {
+            const uint8_t *eol = memchr(p, '\n', end - p), *digits = p;
+            uint64_t size = 0;
+
+            if (!eol)
+                return 0;
+            for (; p < eol && av_isxdigit(*p); p++) {
+                if (size >> 60)
+                    return 0;
+                size = size * 16 + (av_isdigit(*p) ? *p - '0' :
+                                                     av_tolower(*p) - 'a' + 10);
+            }
+            if (p == digits)
+                return 0;
+            p = eol + 1;
+            if (!size)
+                break;
+            /* the chunk data and its CRLF */
+            if (size + 2 > (uint64_t)(end - p) ||
+                p[size] != '\r' || p[size + 1] != '\n')
+                return 0;
+            p += size + 2;
+        }
+        /* the trailer section ends with an empty line */
+        for (;;) {
+            const uint8_t *eol = memchr(p, '\n', end - p), *line = p;
+
+            if (!eol)
+                return 0;
+            p = eol + 1;
+            if (eol == line || (eol == line + 1 && *line == '\r'))
+                break;
+        }
+    }
+
+    /* Anything after the body would be read as the next reply. */
+    if (p != end)
+        return 0;
+    s->buf_ptr = s->buf_end;
+    return 1;
+}
+
 /* return non zero if error */
 static int http_open_cnx(URLContext *h, AVDictionary **options)
 {
@@ -546,7 +617,8 @@ redo:
          s->http_code == 303 || s->http_code == 307 || s->http_code == 308) &&
         s->new_location) {
         /* url moved, get next */
-        ffurl_closep(&s->hd);
+        if (!http_skip_body(h))
+            ffurl_closep(&s->hd);
         if (redirects++ >= s->max_redirects) {
             ret = AVERROR(EIO);
             goto fail;
-- 
2.53.0.windows.2

